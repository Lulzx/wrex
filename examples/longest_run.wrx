# Tropical F2 (spec 14.5)
fn longest_positive_run(xs: [int]) -> int:
    let (_, best) = fold(xs, (0, 0), ((cur, best), x) =>
        let cur2 = if x > 0 then cur + 1 else 0
        (cur2, max(best, cur2)))
    best

fn main(args: [Str]) -> Out:
    print(longest_positive_run([1, 2, -1, 3, 4, 5, 0, 7]))
